# ============================================================
# GURU MUSIC — Environment Configuration
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local or service-role keys to GitHub.
# ============================================================

# Public Website & App URL
NEXT_PUBLIC_SITE_URL=https://music.webguruji.online
NEXT_PUBLIC_APP_NAME="Guru Music"
NEXT_PUBLIC_BRAND_OWNER="HarshGuruJi"

# Supabase Public Configuration (safe for client bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Secret (NEVER expose to client or commit!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Security & Provisioning (Server-Only)
# Comma-separated allowlist of authorized admin emails
ADMIN_ALLOWLIST_EMAILS=harshguruji01@gmail.com
# Admin session max age in seconds (default: 43200 = 12 hours)
ADMIN_SESSION_MAX_AGE_SECONDS=43200
# Optional salt/pepper for rate-limit & audit IP hashing
SECURITY_HASH_SALT=replace-with-a-long-random-hex-string

# Note: Edge Function `music-gateway` automatically receives SUPABASE_URL,
# SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY inside Supabase Edge Runtime.
# Never expose SUPABASE_SERVICE_ROLE_KEY in NEXT_PUBLIC_* variables.
