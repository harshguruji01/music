{
  "name": "guru-music",
  "version": "1.0.0",
  "description": "Guru Music — Premium Music Streaming Platform & Secure CMS by HarshGuruJi",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && python3 scripts/generate_sitemap.py && node scripts/export-to-root.mjs",
    "sitemap": "python3 scripts/generate_sitemap.py",
    "start": "npx serve out",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "admin:provision": "node scripts/provision-admin.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.80.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  }
}
